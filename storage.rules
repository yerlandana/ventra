rules_version = '2';

// IELTS8 LMS: Firebase Storage security rules for lesson files.
// Deploy: paste into Firebase Console → Storage → Rules → Publish.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'dyerlanova@gmail.com';
    }
    match /lessons/{lessonId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      // Teacher only, up to 2 GB per file.
      allow write: if isAdmin() && (request.resource == null || request.resource.size < 2 * 1024 * 1024 * 1024);
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
